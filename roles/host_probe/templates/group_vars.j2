# Generated by roles/host_probe — review before use
---
# Host: {{ inventory_hostname }}
host_probe:
  probe_mode: {{ host_probe_render.probe_mode | default('') }}
  hostname: {{ host_probe_render.hostname | default('') }}
  os:
    distribution: {{ host_probe_render.facts.ansible_facts.ansible_distribution | default('') }}
    version: {{ host_probe_render.facts.ansible_facts.ansible_distribution_version | default('') }}
    kernel: {{ host_probe_render.facts.ansible_facts.ansible_kernel | default('') }}
    machine: {{ host_probe_render.facts.ansible_facts.ansible_machine | default('') }}
  network:
    default_ipv4: "{{ host_probe_render.facts.ansible_facts.ansible_default_ipv4.address | default('') }}"
    interfaces: {{ host_probe_render.facts.ansible_facts.ansible_interfaces | default([]) }}
  commands:
    ip: |
{{ host_probe_render.facts.ip | default('') | indent(6) }}
    lsblk: |
{{ host_probe_render.facts.lsblk | default('') | indent(6) }}
    hostnamectl: |
{{ host_probe_render.facts.hostnamectl | default('') | indent(6) }}
  fetched_files:
{% if host_probe_render.fetched %}
{% for item in host_probe_render.fetched %}
    - src: "{{ item.src | default('') }}"
      dest: "{{ item.dest | default('') }}"
      size: {{ item.stat.size | default(0) }}
{% endfor %}
{% else %}
    - []
{% endif %}
