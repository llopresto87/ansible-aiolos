{% for route in nginx_proxy_configure_routes %}
server {
    listen 80;
    server_name {{ route.domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ route.domain }};

    ssl_certificate {{ nginx_proxy_configure_tls_cert_path_resolved }};
    ssl_certificate_key {{ nginx_proxy_configure_tls_key_path_resolved }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location / {
        proxy_pass {{ route.upstream_scheme | default(nginx_proxy_configure_default_upstream_scheme_resolved) }}://{{ route.upstream_host }}:{{ route.upstream_port | default(nginx_proxy_configure_default_upstream_port_resolved) }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
{% endfor %}